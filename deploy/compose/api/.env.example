# Copy to .env on the server host and fill in. Never commit .env.
# BIND_IP: the host's Tailscale IP in production (100.94.155.4), 127.0.0.1 for local tests.
BIND_IP=127.0.0.1
PG_PORT=5432
PG_OWNER_PASSWORD=
MINIO_ROOT_USER=ao-minio
MINIO_ROOT_PASSWORD=
# Role passwords the migration sets (ao_app = the API, ao_readonly = the SQL runner/admin views).
AO_APP_PASSWORD=
AO_READONLY_PASSWORD=
AO_ADMIN_PASSWORD=
BACKUP_EVERY_SECONDS=86400
BACKUP_KEEP_DAYS=14
# Admin API: name:token pairs (token 24+ chars) until Clerk admin sign-in is wired.
AO_ADMIN_TOKENS=
API_PORT=8787
# Optional: lets "force sign-out" revoke Clerk sessions. Server-side only.
CLERK_SECRET_KEY=
# Where api/, node_modules/ and package.json live on the host (default: ..).
# AO_SERVER_DIR=./server
# Clerk sign-in for devices (sync API /v1/*) and admins. The publishable key is enough to verify
# session tokens; admins are users whose session token carries role "admin" (public metadata).
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=

# pgAdmin (database workbench, http://localhost:5050 on the host). Sign-in email and password.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=

# Our own sign-in (apps/console): its public base URL (the OAuth issuer) and the password of its database role.
AO_AUTH_PASSWORD=
AUTH_ISSUER=
AUTH_JWKS_URL=
# Managed inference: AO_PRICING='{"model-id":{"in":1,"out":4}}' (credits per 1,000 tokens), and the provider behind it.
AO_PRICING=
AO_UPSTREAM_URL=
AO_UPSTREAM_KEY=

# Announcement email (leave empty to keep email off): a Resend API key and a verified sender, e.g. "Agentic Office <hello@your-domain>".
RESEND_API_KEY=
AO_MAIL_FROM=

# Keycloak (leave empty until it is published). Issuer = the realm URL as it appears in tokens, e.g. https://auth.example/realms/agentic-office
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_ADMIN_URL=
KEYCLOAK_API_SECRET=

# Payments (OFF unless AO_PAYMENTS is set AND the settings below exist). The only provider is EXPERIMENTAL: a signed notice from it is an
# observation, never proof of payment; a plan is activated only when an admin settles the order after checking the bank. Use a sandbox first.
AO_BILLING_PASSWORD=
AO_PAYMENTS=
YOUPI_API_URL=
YOUPI_MERCHANT_ID=
YOUPI_WEBHOOK_SECRET=
AO_CHECKOUT_RETURN_URL=

# Browser origins allowed to call /v1. Empty = any origin (callers use a bearer token, never cookies). Or list exact origins, comma-separated.
AO_CORS_ORIGINS=

# Promotion media links (src/growth/engine.ts): a random secret of 32+ characters, e.g. `openssl rand -hex 32`.
AO_MEDIA_SIGNING_KEY=

# Campaign email (refused unless all three are set): the public https base of /v1/unsubscribe and /v1/webhooks/resend,
# a random 32+ character key for unsubscribe links, and Resend's webhook signing secret (whsec_...).
AO_PUBLIC_URL=
AO_UNSUBSCRIBE_KEY=
RESEND_WEBHOOK_SECRET=

# Package verifier (Hermes skill scanner + agent compiler). Internal address; leave as is unless you moved it.
VERIFIER_URL=http://verifier:8089

# Service status. The API runs its own checks (database, verifier, Keycloak keys); set AO_STATUS=off to stop them.
AO_STATUS=
# More checks from inside the API (JSON list of {"id","label","url"}), and the prober's checks of the PUBLIC addresses (same shape).
AO_STATUS_PROBES=
PROBER_PROBES=

# Help assistant for the admin console (off until set). Any OpenAI-compatible provider: base URL ending in /v1, one key or several
# separated by commas (they are used in turn and rest when a provider rate-limits them). The keys go into THIS file on the host
# (deploy/scripts/set-help-keys.sh asks for them without echoing); never into chat, git or a ticket.
AO_HELP_BASE_URL=
AO_HELP_API_KEYS=
AO_HELP_CHAT_MODEL=
AO_HELP_EMBED_MODEL=
# Laya shadow mode: the API gate sends a copy of each managed inference request (without the person's token) here and throws the
# answer away. A container on this compose network with no published port, e.g. http://laya:9100. Empty: off.
LAYA_SHADOW_URL=
