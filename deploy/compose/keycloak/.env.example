# Copy to .env (mode 600). Never commit real values.
KC_DB_PASSWORD=
KC_ADMIN_USER=kcadmin
KC_ADMIN_PASSWORD=
# The URL browsers use to reach Keycloak (becomes the token issuer's origin), e.g. https://host.tailnet.ts.net:8444
KC_HOSTNAME=
# The sign-in service's own public base (used for the admin console's redirect addresses), e.g. https://host.tailnet.ts.net
AO_PUBLIC_URL=
AO_ADMIN_CONSOLE_SECRET=
AO_API_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BIND_IP=127.0.0.1
KC_PORT=8180
DATA_NETWORK=ao-live_default
