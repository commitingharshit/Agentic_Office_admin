# Copy to .env next to docker-compose.yml. Never commit .env.
BIND_IP=127.0.0.1
WEB_PORT=8791
DATA_NETWORK=agentic-office-data_default
# The public address of this service. It is the OAuth issuer: accounts-sync's AUTH_ISSUER must be exactly this.
AUTH_BASE_URL=
AUTH_SECRET=
AO_AUTH_PASSWORD=
AO_ADMIN_API_TOKEN=
# Hostnames the admin console answers on (the private ones). Anything else gets a 404. Keep `localhost` in the list: form actions
# redirect through it. Add the private name people use, e.g. ADMIN_HOSTS=100.95.14.113,my-host.tailnet.ts.net,localhost
ADMIN_HOSTS=127.0.0.1,localhost
# The header the public tunnel sets with the real client address (rate limits key on it).
AUTH_IP_HEADER=cf-connecting-ip
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Admin two-factor sign-in. On unless this is exactly "false". Switching it off shows a warning banner in the console.
ADMIN_REQUIRE_MFA=true

# Keycloak sign-in for the console (leave empty until Keycloak is published): realm URL as in tokens, the console client's secret, and where Keycloak is reached from here.
KEYCLOAK_ISSUER=
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_CONSOLE_SECRET=
