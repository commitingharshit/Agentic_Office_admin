+    failedReasons: Array.isArray(r.failedReasons) ? r.failedReasons.filter((x: any) => x && typeof x.reason === 'string').map((x: any) => ({ reason: x.reason, count: Number(x.count) || 0 })) : [],
+  }));
+}
