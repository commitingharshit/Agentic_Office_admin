+export function typeRows(d: { byType?: unknown } | null | undefined): TypeStats[] {
+  if (!d || !Array.isArray(d.byType)) return [];
+  return (d.byType as any[]).filter((r) => r && typeof r.type === 'string').map((r) => ({
