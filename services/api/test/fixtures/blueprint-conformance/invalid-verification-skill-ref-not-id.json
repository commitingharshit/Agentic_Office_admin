{
  "schema": "agentic.agent-blueprint/1",
  "identity": {
    "name": "Analyst",
    "role": "Research analyst",
    "description": "Summarises filings.",
    "instructionsFile": "SOUL.md"
  },
  "objective": {
    "goal": "Produce a sourced summary.",
    "successCriteria": [
      "every claim cites a source"
    ]
  },
  "executionEnvironments": [
    "desktop"
  ],
  "verificationPolicy": {
    "checks": [
      {
        "name": "c",
        "kind": "skill",
        "ref": "bash -c x",
        "when": "before-final",
        "onFail": "abort",
        "maxAttempts": 1
      }
    ],
    "requireEvidence": false
  }
}
