{
  "name": "agentic-office-server",
  "private": true,
  "type": "module",
  "scripts": {
    "migrate": "node ../../database/migrate.ts",
    "test": "node --test test/*.test.ts",
    "test:postgres": "bash test/run-with-postgres.sh",
    "eval": "node evals/run-scan-gate.ts && node evals/run-template-validator.ts && node evals/run-blueprint-validator.ts && node evals/run-bundle-validator.ts && node evals/run-advanced-gate.ts",
    "eval:scan-gate": "node evals/run-scan-gate.ts",
    "eval:templates": "node evals/run-template-validator.ts",
    "eval:blueprints": "node evals/run-blueprint-validator.ts",
    "eval:bundles": "node evals/run-bundle-validator.ts && node evals/run-advanced-gate.ts",
    "eval:verification": "node evals/run-verification.ts --allow-skip not-discriminating,prerequisite-skipped:render-pages",
    "eval:advanced": "node evals/run-advanced-gate.ts",
    "eval:differential": "node evals/run-template-differential.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
